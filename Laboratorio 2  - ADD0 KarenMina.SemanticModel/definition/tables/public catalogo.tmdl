table 'public catalogo'
	lineageTag: f17e8db8-1428-4d44-9348-921af085b39f

	measure 'Operaciones Pendientes' =
			
			CALCULATE(
			    COUNTROWS('public operaciones'),
			    'public operaciones'[estado] = "pendiente"
			)
		formatString: 0
		lineageTag: 6b73eeb6-b2b3-4ba0-98fd-d5727615fc40

	measure '% Operaciones Completadas' =
			
			DIVIDE(
			    [Operaciones Completadas],
			    [Total Operaciones],
			    0
			)
		lineageTag: 2d438451-9855-4862-95fb-ce3d1d05e618

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Clientes' =
			
			DISTINCTCOUNT('public clientes'[cliente_id])
		formatString: 0
		lineageTag: c569e24c-8c73-4154-8481-8366e4df9f19

	measure 'Clientes Frecuentes' =
			
			CALCULATE(
			    DISTINCTCOUNT('public clientes'[cliente_id]),
			    'public clientes'[segmento] = "Frecuente"
			)
		formatString: 0
		isHidden
		lineageTag: 90a88368-61ca-49a0-9539-67779a509776

		changedProperty = IsHidden

	measure 'Clientes Nuevos' =
			
			CALCULATE(
			    DISTINCTCOUNT('public clientes'[cliente_id]),
			    'public clientes'[segmento] = "Nuevo"
			)
		formatString: 0
		lineageTag: 63e32b42-a032-4b44-949e-ffb8506bf22c

	measure 'Clientes Ocasionales' =
			
			CALCULATE(
			    DISTINCTCOUNT('public clientes'[cliente_id]),
			    'public clientes'[segmento] = "Ocasional"
			)
		formatString: 0
		lineageTag: b23ce36c-55ff-4756-bc7e-db2038482d57

	measure 'Unidades Operadas' =
			
			SUM('public detalle_operacion'[cantidad])
		formatString: 0
		lineageTag: 8859c344-bfd5-45d6-b77d-e62541b4d94c

	measure 'Total Productos' =
			
			DISTINCTCOUNT('public catalogo'[producto_id])
		formatString: 0
		lineageTag: 0e5df4d5-6dbe-4f37-afbf-3cea54ca4244

	measure 'Precio Promedio Unitario' =
			
			AVERAGE('public detalle_operacion'[precio_unitario])
		lineageTag: 71c8b01b-2958-4823-822f-ae4464faf42d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ingresos Brutos' =
			
			SUMX(
			    'public detalle_operacion',
			    'public detalle_operacion'[cantidad] *
			    'public detalle_operacion'[precio_unitario]
			)
		lineageTag: 046c956f-6934-49d8-a968-4403de7f0901

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Descuentos Totales' =
			
			SUM('public detalle_operacion'[descuento])
		lineageTag: 5f5e2a9f-cc9d-4f9a-b9d0-f3b9dbcb8823

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ingresos Netos' =
			
			[Ingresos Brutos] - [Descuentos Totales]
		lineageTag: 34174e07-32ff-4707-924f-282a818f79e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ingresos Netos Completados' =
			
			CALCULATE(
			    [Ingresos Netos],
			    'public operaciones'[estado] = "completada"
			)
		lineageTag: 0ebfbe8a-3217-43b7-af35-47070483c3fe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Sedes' =
			
			DISTINCTCOUNT('public sedes'[sede_id])
		formatString: 0
		lineageTag: ecd20733-253e-447f-8b84-bb707fd37199

	measure 'Total Categorias' =
			
			DISTINCTCOUNT('public catalogo'[categoria])
		formatString: 0
		lineageTag: 7b654fff-dde8-4ba7-8421-8e6718e6ad27

	measure 'Promedio Operaciones por Cliente' =
			
			DIVIDE(
			    [Total Operaciones],
			    [Total Clientes],
			    0
			)
		lineageTag: af7866ff-2ceb-4c7b-9f20-adc467641cb9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importe Bruto' =
			
			SUMX(
			    'public detalle_operacion',
			    'public detalle_operacion'[cantidad] *
			    'public detalle_operacion'[precio_unitario]
			)
		lineageTag: d6cbf9ab-f7a0-4f21-8a4d-f11d7b4ff77f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column producto_id
		dataType: int64
		formatString: 0
		lineageTag: 240016c6-93dd-4db2-8851-17d68e897776
		summarizeBy: none
		sourceColumn: producto_id

		annotation SummarizationSetBy = Automatic

	column nombre
		dataType: string
		lineageTag: 71c2db4d-8310-4bab-bf66-b1ad77f5d480
		summarizeBy: none
		sourceColumn: nombre

		annotation SummarizationSetBy = Automatic

	column categoria
		dataType: string
		lineageTag: 9729c431-374d-43ed-8c32-005947d8be1e
		summarizeBy: none
		sourceColumn: categoria

		annotation SummarizationSetBy = Automatic

	column precio_lista
		dataType: double
		lineageTag: 1d84c52e-f975-4af6-913d-88808c29ce29
		summarizeBy: none
		sourceColumn: precio_lista

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'public catalogo' = m
		mode: import
		source =
				let
				  Origen = PostgreSQL.Database("ep-dark-dust-bd04sqoq-pooler.c-8.us-east-2.aws.neon.tech", "taller"),
				  #"Navegación 1" = Origen{[Schema = "public", Item = "catalogo"]}[Data],
				  #"Filas filtradas" = Table.SelectRows(#"Navegación 1", each ([nombre] <> null and [nombre] <> "   " and [nombre] <> "N/A" and [nombre] <> "Prodcto mal escrto"))
				in
				  #"Filas filtradas"

	annotation PBI_ResultType = Table

